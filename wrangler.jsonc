{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relaytester",
  "compatibility_date": "2026-05-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "/coordenograma/*",
      "custom_domain": false
    },
    {
      "pattern": "/newton-rapson/*",
      "custom_domain": false
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
